---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Cobus van Vuuren | Business Automation Assessments for SA Professional Services',
  description = 'Business Automation Assessments for South African accountants, attorneys, and financial advisors. 90-minute intake, five-day turnaround, R50,000 minimum savings guaranteed or full refund.',
  image = '/images/og-default.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}

  <!-- Meta Pixel: loaded directly and immediately (not deferred to GTM's idle callback below).
       Fixes a confirmed 6.5s delay: GTM's Facebook Pixel tag only fired PageView after
       requestIdleCallback + fbevents.js round-trip, which meant Meta-ad traffic bouncing
       before ~6.5s (very plausible on mobile in-app browsers) never registered as a Landing
       Page View. This snippet fires PageView within ~1-2s of DOMContentLoaded instead.
       GTM (GTM-KDZJDQR) may still have its own Facebook Pixel PageView tag configured. That
       one should be removed/paused in the GTM container to avoid a duplicate PageView per
       visit; harmless to leave for now (Meta doesn't penalize it), just worth cleaning up. -->
  <script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '152246882234280');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=152246882234280&ev=PageView&noscript=1"
  /></noscript>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="en_ZA" />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <title>{title}</title>

  <!-- Fonts: Space Grotesk + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Additional head content (schema, page-specific meta) -->
  <slot name="head" />

  <!-- Google Tag Manager (script injection deferred to idle time so it doesn't compete with fonts/critical-path requests for early bandwidth) -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});
  function loadGTM(){var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);}
  if('requestIdleCallback' in w){w.requestIdleCallback(loadGTM,{timeout:2000});}else{w.setTimeout(loadGTM,1);}
  })(window,document,'script','dataLayer','GTM-KDZJDQR');</script>
</head>
<body class="antialiased">
  <!-- GTM noscript -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KDZJDQR"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <!-- Background scene: grid + orbs + grain (grain is body::after in CSS) -->
  <div class="bg-scene" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-orb bg-orb-crimson"></div>
    <div class="bg-orb bg-orb-warm"></div>
    <div class="bg-orb bg-orb-accent"></div>
  </div>

  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-[9999] bg-[#0B0A09]/80 backdrop-blur-md border-b border-white/5">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="font-serif font-normal text-[13px] tracking-[0.18em] uppercase text-ivory/90 hover:text-ivory transition-colors duration-300 flex items-center gap-2">
        Cobus van Vuuren
        <span class="nav-cursor" aria-hidden="true"></span>
      </a>
      <div class="flex items-center gap-5">
        <a href="/ai-automation/" class="hidden md:block font-sans text-[12px] font-normal text-smoke hover:text-ivory/80 transition-colors duration-200">Builds</a>
        <a href="/articles/" class="hidden md:block font-sans text-[12px] font-normal text-smoke hover:text-ivory/80 transition-colors duration-200">Articles</a>
        <a href="/about/"    class="hidden md:block font-sans text-[12px] font-normal text-smoke hover:text-ivory/80 transition-colors duration-200">About</a>
        <a href="/score/" class="btn-primary !py-2.5 !px-4 !text-[11px]">
          Free Diagnostic →
        </a>
      </div>
    </div>
  </nav>

  <!-- Page content -->
  <main class="relative z-[1]">
    <slot />
  </main>

  <!-- SITEWIDE INTERACTIONS -->
  <script is:inline>
  (function () {
    // Scroll reveal
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-anim]').forEach(function (el) { obs.observe(el); });

    // Magnetic buttons (desktop only)
    if (window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll('.btn-primary, .btn-ghost-dark').forEach(function (btn) {
        // Cache the rect once on enter -- before any transform is applied --
        // instead of calling getBoundingClientRect() on every mousemove.
        // Reading layout mid-move forces a reflow AND reads the button's own
        // already-transformed box back into the next frame's calculation.
        var r = null;
        btn.addEventListener('mouseenter', function () {
          r = btn.getBoundingClientRect();
          btn.style.transition = 'transform 0.1s ease';
        });
        btn.addEventListener('mousemove', function (e) {
          if (!r) return;
          var x = ((e.clientX - r.left) / r.width - 0.5) * 9;
          var y = ((e.clientY - r.top) / r.height - 0.5) * 6;
          btn.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
        });
        btn.addEventListener('mouseleave', function () {
          r = null;
          btn.style.transform = '';
          btn.style.transition = 'transform 0.45s ease, background-color 0.2s ease, box-shadow 0.2s ease';
        });
      });
    }

    // Number counters (elements with data-count attribute)
    var countObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var target = parseFloat(el.dataset.count);
        var isFloat = !!el.dataset.countFloat;
        var dur = 1100;
        var start = performance.now();
        function tick(now) {
          var t = Math.min((now - start) / dur, 1);
          var eased = 1 - Math.pow(1 - t, 3);
          el.textContent = isFloat ? (eased * target).toFixed(1) : Math.round(eased * target);
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        countObs.unobserve(el);
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach(function (el) { countObs.observe(el); });
  })();
  </script>

  <!-- FOOTER -->
  <footer class="relative z-[1] border-t border-white/5 py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex flex-col items-center md:items-start gap-1">
        <p class="font-sans text-[13px] font-normal text-smoke">
          © 2026 Cobus van Vuuren. Business Automation Assessments for SA professional services firms.
        </p>
        <p class="font-sans text-[11px]" style="color:rgba(122,118,110,0.4);">
          Powered by <a href="https://rhinoberry.co.za" target="_blank" rel="noopener" style="color:rgba(122,118,110,0.5);text-decoration:none;" onmouseover="this.style.color='rgba(166,124,82,0.7)'" onmouseout="this.style.color='rgba(122,118,110,0.5)'">RhinoBerry</a>
        </p>
      </div>
      <div class="flex items-center gap-6">
        <a href="/ai-automation/" class="font-sans text-[12px] font-normal text-smoke hover:text-ivory transition-colors duration-200">Builds</a>
        <a href="/privacy/"  class="font-sans text-[12px] font-normal text-smoke hover:text-ivory transition-colors duration-200">Privacy</a>
        <a href="/terms/"    class="font-sans text-[12px] font-normal text-smoke hover:text-ivory transition-colors duration-200">Terms</a>
        <a href="https://www.linkedin.com/in/cobusvanvuuren/" target="_blank" rel="noopener noreferrer" class="font-sans text-[12px] font-normal text-smoke hover:text-ivory transition-colors duration-200">LinkedIn</a>
        <a href="mailto:cobus@rhinoberry.com" class="font-sans text-[12px] font-normal text-smoke hover:text-ivory transition-colors duration-200">Email</a>
      </div>
    </div>
  </footer>

</body>
</html>
