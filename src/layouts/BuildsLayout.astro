---
// Shared shell for /builds/ — the "systems I've built" hub and its child
// pages (Okapi today; Spoorsny/Oxpecker/Meerkat/Hamerkop as they're written).
// Header/footer chrome matches Base.astro exactly (2026-09-15 fix -- the
// prior version used RhinoBerry's brand tokens here instead of CVV's own,
// which read as two different sites when clicking through). Section bodies
// below the breadcrumb bar keep their own Performance Mono treatment
// (black/white/crimson-accent, mono labels) -- that's the accepted
// difference, not the header/footer. `is:global` on the <style>
// block is required, not optional — several pages inject markup into the
// DOM via client-side JS (anatomy panels, steppers), and Astro's normal
// scoped-CSS attribute is only applied to elements it compiles from the
// template, never to elements created with document.createElement/innerHTML.
import '../styles/global.css';
interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  breadcrumb?: Crumb[];
  navLinks?: { href: string; label: string }[];
}
const {
  title,
  description,
  breadcrumb = [{ label: 'Cobus van Vuuren', href: '/' }, { label: 'Builds', href: '/builds/' }],
  navLinks = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" href="/favicon.png" />
<title>{title}</title>
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#111111; --paper:#FFFFFF; --stone:#F1F1EF; --accent:#FF4A1C;
  --accent-text:#C93A13; /* darkened accent — small text on light backgrounds needs 4.5:1, #FF4A1C only clears ~3.4:1 there */
  --rule:#dedede; --rule-soft:#e8e8e6; --muted:#5a5a58; --muted-2:#8a8a85;
  --display:'Space Grotesk',system-ui,sans-serif;
  --body:'Inter',system-ui,-apple-system,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body.builds-body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);-webkit-font-smoothing:antialiased;line-height:1.5}
.builds-body h1,.builds-body h2,.builds-body h3,.builds-body h4{font-family:var(--display);font-weight:700;letter-spacing:-.02em;margin:0}
.builds-body p{margin:0}
.builds-body a{color:inherit}
/* The Base.astro-matching nav/footer below use Tailwind colour utilities
   (.text-smoke etc), but .builds-body a{color:inherit} above has higher
   specificity than a single Tailwind utility class and was silently
   winning, making those links nearly invisible. Restore explicitly. */
.builds-body nav.sticky a, .builds-body footer.relative a{color:#A09C94}
.builds-body nav.sticky a:hover, .builds-body footer.relative a:hover{color:#F5F0E8}
.builds-body nav.sticky a.font-serif{color:rgba(245,240,232,.9)}
.builds-body nav.sticky a.font-serif:hover{color:#F5F0E8}
.builds-body nav.sticky a.btn-primary,.builds-body nav.sticky a.btn-primary:hover{color:#fff}
.builds-body button{font-family:inherit;cursor:pointer}
.builds-body .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.builds-body .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2)}
.builds-body .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.builds-body :focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* ---------- top nav ---------- */
.builds-body .topnav{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);border-bottom:1px solid var(--rule)}
.builds-body .topnav .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;gap:16px}
.builds-body .crumb{display:flex;align-items:center;gap:8px;font-size:13px;white-space:nowrap}
.builds-body .crumb a{text-decoration:none;color:var(--muted-2)}
.builds-body .crumb a:hover,.builds-body .crumb a:focus-visible{color:var(--ink)}
.builds-body .crumb .sep{color:var(--muted-2);opacity:.6}
.builds-body .crumb .current{font-family:var(--display);font-weight:700;font-size:16px;letter-spacing:-.02em;color:var(--ink)}
@media(max-width:520px){.builds-body .crumb a:not(:last-child){display:none}.builds-body .crumb .sep{display:none}}
.builds-body .navlinks{display:flex;gap:22px;list-style:none;margin:0;padding:0;font-size:13px}
.builds-body .navlinks a{text-decoration:none;color:var(--muted);border-bottom:1px solid transparent;padding-bottom:2px}
.builds-body .navlinks a:hover,.builds-body .navlinks a:focus-visible{color:var(--ink);border-color:var(--accent)}
@media(max-width:720px){.builds-body .navlinks{display:none}}

/* ---------- hero ---------- */
.builds-body .hero{background:var(--ink);color:var(--paper);position:relative;overflow:hidden;padding:120px 0 96px}
.builds-body .hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(#ffffff14 1px,transparent 1px);background-size:22px 22px;pointer-events:none}
.builds-body .hero .wrap{position:relative}
.builds-body .hero .eyebrow{color:#ffffff85}
.builds-body .hero h1{font-size:clamp(34px,5.4vw,58px);line-height:1.06;max-width:15ch;margin:18px 0 26px}
.builds-body .hero h1 em{font-style:normal;color:var(--accent)}
.builds-body .hero p.lede{font-size:18px;line-height:1.65;max-width:56ch;color:#ffffffc0;margin-bottom:0}
.builds-body .hero-grid{display:grid;grid-template-columns:1fr auto;align-items:center;gap:48px}
@media(max-width:820px){.builds-body .hero-grid{grid-template-columns:1fr}}
.builds-body .hero-mark-wrap{position:relative;flex-shrink:0;width:180px}
@media(max-width:820px){.builds-body .hero-mark-wrap{width:110px;justify-self:start}}
.builds-body .hero-mark{width:100%;height:auto;display:block;opacity:.95}
@media(prefers-reduced-motion: no-preference){
  .builds-body .hero-mark{animation:builds-idle 4.6s ease-in-out infinite;transform-origin:70% 85%}
}
@keyframes builds-idle{
  0%,100%{transform:translateY(0) rotate(0deg)}
  50%{transform:translateY(-5px) rotate(-1.5deg)}
}
.builds-body .close-mark{width:48px;height:auto;margin:0 auto 20px;display:block}
/* "flies" -- review-platform marks orbiting the head, positioned against the
   generated mark's real head bounding box (top ~10-29%, left ~51-88% of the
   1024x1024 canvas), not guessed. Each carries a brand-colour ring so the
   smaller/more abstract marks (Trustpilot, Hellopeter) still read at a glance. */
.builds-body .fly{position:absolute;border-radius:50%;background:var(--paper);box-shadow:0 2px 6px #00000055;padding:4px;border:2px solid var(--fly-ring, transparent)}
.builds-body .fly-1{top:-4%;left:54%;--fly-ring:#4285F4}
.builds-body .fly-2{top:-14%;left:75%;--fly-ring:#0866FF}
.builds-body .fly-3{top:4%;left:100%;--fly-ring:#00B67A}
.builds-body .fly-4{top:26%;left:96%;--fly-ring:#1B2A4A}
@media(prefers-reduced-motion: no-preference){
  .builds-body .fly-1{animation:builds-buzz-a 3.4s ease-in-out infinite}
  .builds-body .fly-2{animation:builds-buzz-b 4.1s ease-in-out infinite .5s}
  .builds-body .fly-3{animation:builds-buzz-c 3.1s ease-in-out infinite .9s}
  .builds-body .fly-4{animation:builds-buzz-b 3.7s ease-in-out infinite .2s}
}
@keyframes builds-buzz-a{
  0%,100%{transform:translate(0,0)} 25%{transform:translate(9px,-10px)}
  50%{transform:translate(-6px,-4px)} 75%{transform:translate(4px,7px)}
}
@keyframes builds-buzz-b{
  0%,100%{transform:translate(0,0)} 30%{transform:translate(-10px,6px)}
  60%{transform:translate(7px,10px)} 85%{transform:translate(-4px,-6px)}
}
@keyframes builds-buzz-c{
  0%,100%{transform:translate(0,0)} 40%{transform:translate(8px,9px)}
  70%{transform:translate(-9px,-3px)}
}

/* ---------- section shell ---------- */
.builds-body section{padding:88px 0;border-bottom:1px solid var(--rule-soft)}
.builds-body section.stone{background:var(--stone)}
.builds-body .sec-head{max-width:64ch;margin-bottom:48px}
.builds-body .sec-head h2{font-size:clamp(24px,3vw,34px);margin-bottom:14px}
.builds-body .sec-head p{font-size:16px;line-height:1.65;color:var(--muted)}

/* ---------- premise-style two-column ---------- */
.builds-body .premise-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
@media(max-width:760px){.builds-body .premise-grid{grid-template-columns:1fr}}
.builds-body .premise-grid .col h3{font-family:var(--mono);font-weight:600;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:14px}
.builds-body .premise-grid .col p{font-size:15.5px;line-height:1.7;color:var(--ink)}
.builds-body .premise-grid .col p + p{margin-top:12px}

/* ---------- anatomy (band list + detail) ---------- */
.builds-body .anatomy{display:grid;grid-template-columns:340px 1fr;gap:0;border:1px solid var(--rule)}
@media(max-width:800px){.builds-body .anatomy{grid-template-columns:1fr}}
.builds-body .bandlist{list-style:none;margin:0;padding:0;border-right:1px solid var(--rule)}
@media(max-width:800px){.builds-body .bandlist{border-right:none;border-bottom:1px solid var(--rule)}}
.builds-body .bandlist li{border-bottom:1px solid var(--rule)}
.builds-body .bandlist li:last-child{border-bottom:none}
.builds-body .band-btn{display:flex;align-items:center;gap:14px;width:100%;background:var(--paper);border:none;text-align:left;padding:18px 22px;transition:background .12s ease}
.builds-body .band-btn:hover{background:var(--stone)}
.builds-body .band-btn[aria-selected="true"]{background:var(--ink);color:var(--paper)}
.builds-body .band-num{font-family:var(--mono);font-size:11px;color:var(--muted-2);min-width:22px}
.builds-body .band-btn[aria-selected="true"] .band-num{color:#ffffff70}
.builds-body .band-name{font-family:var(--display);font-weight:700;font-size:15.5px}
.builds-body .anatomy-detail{padding:36px 40px;background:var(--paper)}
.builds-body .anatomy-detail .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-text);margin-bottom:10px}
.builds-body .anatomy-detail h3{font-size:24px;margin-bottom:14px}
.builds-body .anatomy-detail .answers{font-size:15px;line-height:1.7;color:var(--muted);margin-bottom:18px}
.builds-body .anatomy-detail .lives-in{font-size:13.5px;line-height:1.6;color:var(--ink);margin-bottom:16px}
.builds-body .anatomy-detail .lives-in strong{font-family:var(--mono);font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2);display:block;margin-bottom:6px}
.builds-body .mech{border-top:1px solid var(--rule-soft);padding-top:16px;font-size:14px;line-height:1.65;font-style:italic;color:var(--ink)}

/* ---------- stepper ---------- */
.builds-body .stepper-shell{border:1px solid var(--rule)}
.builds-body .step-rail{display:flex;overflow-x:auto;border-bottom:1px solid var(--rule);background:var(--stone)}
.builds-body .step-tab{flex:1 0 auto;min-width:104px;padding:14px 10px;background:transparent;border:none;border-right:1px solid var(--rule);text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--muted)}
.builds-body .step-tab:last-child{border-right:none}
.builds-body .step-tab .n{display:block;font-size:10px;color:var(--muted-2);margin-bottom:4px}
.builds-body .step-tab[aria-selected="true"]{background:var(--ink);color:var(--paper)}
.builds-body .step-tab[aria-selected="true"] .n{color:var(--accent)}
.builds-body .step-panel{padding:40px}
.builds-body .step-panel h3{font-size:22px;margin-bottom:12px}
.builds-body .step-panel p{font-size:15px;line-height:1.7;color:var(--muted);max-width:60ch}
.builds-body .step-nav{display:flex;justify-content:space-between;padding:0 40px 32px}
.builds-body .step-nav button{background:var(--ink);color:var(--paper);border:none;padding:11px 20px;font-size:13px;font-weight:500}
.builds-body .step-nav button:disabled{opacity:.3;cursor:default}
.builds-body .step-nav button:not(:disabled):hover{background:var(--accent)}

/* ---------- loop diagram ---------- */
.builds-body .loop-wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
@media(max-width:780px){.builds-body .loop-wrap{grid-template-columns:1fr}}
.builds-body .loop-svg{width:100%;height:auto}
.builds-body .loop-node-label{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;fill:var(--ink)}
.builds-body .loop-copy p{font-size:15.5px;line-height:1.75;color:var(--muted)}
.builds-body .loop-copy p + p{margin-top:16px}
.builds-body .loop-copy strong{color:var(--ink)}
@media(prefers-reduced-motion: no-preference){
  .builds-body .loop-stroke{stroke-dasharray:8 6;animation:builds-dash 5s linear infinite}
}
@keyframes builds-dash{to{stroke-dashoffset:-140}}

/* ---------- tiles (guardrails-style grid) ---------- */
.builds-body .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)}
@media(max-width:820px){.builds-body .tiles{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.builds-body .tiles{grid-template-columns:1fr}}
.builds-body .tile{background:var(--paper);padding:28px 26px}
.builds-body .tile .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-text);margin-bottom:10px}
.builds-body .tile h4{font-size:16px;margin-bottom:10px;line-height:1.3}
.builds-body .tile p{font-size:13.5px;line-height:1.6;color:var(--muted)}

/* ---------- two-column comparison ---------- */
.builds-body .isnt{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--rule)}
@media(max-width:700px){.builds-body .isnt{grid-template-columns:1fr}}
.builds-body .isnt .col{padding:36px 40px}
.builds-body .isnt .col:first-child{border-right:1px solid var(--rule);background:var(--stone)}
@media(max-width:700px){.builds-body .isnt .col:first-child{border-right:none;border-bottom:1px solid var(--rule)}}
.builds-body .isnt h3{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:20px}
.builds-body .isnt ul{list-style:none;margin:0;padding:0}
.builds-body .isnt li{font-size:15.5px;line-height:1.7;padding:10px 0;border-bottom:1px dotted var(--rule)}
.builds-body .isnt li:last-child{border-bottom:none}
.builds-body .isnt .col:first-child li{color:var(--muted);text-decoration:line-through;text-decoration-color:#c8c8c4}
.builds-body .isnt .col:last-child li{color:var(--ink);font-weight:500}
.builds-body .portability{margin-top:28px;padding-top:22px;border-top:1px solid var(--rule);font-size:14px;line-height:1.65;color:var(--muted)}

/* ---------- CTA block (want-this-in-your-business) ---------- */
.builds-body .cta-sec{background:var(--stone)}
.builds-body .cta-block{text-align:center;max-width:640px;margin:0 auto}
.builds-body .cta-block .eyebrow{color:var(--accent-text)}
.builds-body .cta-block h2{font-size:clamp(22px,2.8vw,30px);margin:14px 0 28px;line-height:1.32}
.builds-body .cta-link{display:inline-block;background:var(--ink);color:var(--paper);text-decoration:none;padding:15px 28px;font-family:var(--display);font-weight:700;font-size:14.5px;letter-spacing:-.01em}
.builds-body .cta-link:hover,.builds-body .cta-link:focus-visible{background:var(--accent)}

/* ---------- capability-page shared components (added 2026-09-15) ---------- */
.builds-body .status-chip{display:inline-block;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;padding:5px 11px;border:1px solid var(--rule);border-radius:2px;color:var(--muted)}
.builds-body .status-chip.chip-live{color:var(--accent-text);border-color:var(--accent-text)}
.builds-body .category-line{font-size:15px;line-height:1.6;color:#ffffffb0;max-width:52ch;margin-top:18px;padding-top:18px;border-top:1px solid #ffffff26}
.builds-body .category-line strong{color:var(--paper)}
.builds-body .offer-cards{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--rule);border:1px solid var(--rule)}
@media(max-width:760px){.builds-body .offer-cards{grid-template-columns:1fr}}
.builds-body .offer-card{background:var(--paper);padding:32px 30px}
.builds-body .offer-card .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-text);margin-bottom:10px}
.builds-body .offer-card h4{font-size:19px;margin-bottom:12px}
.builds-body .offer-card p{font-size:14.5px;line-height:1.65;color:var(--muted)}
.builds-body .offer-card p+p{margin-top:10px}
.builds-body .illustrative-frame{border:1px dashed var(--rule);background:var(--stone);padding:0}
.builds-body .illustrative-tag{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px dashed var(--rule);font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2)}
.builds-body .illustrative-body{padding:24px 26px;font-size:14.5px;line-height:1.65;color:var(--ink)}
.builds-body .proof-box{border-left:3px solid var(--accent);background:var(--stone);padding:22px 26px;font-size:15px;line-height:1.7;color:var(--ink)}
.builds-body .proof-box .stat{font-family:var(--display);font-weight:700;color:var(--accent-text)}

/* ---------- builds index (hub) ---------- */
.builds-body .buildlist{display:flex;flex-direction:column;border:1px solid var(--rule)}
.builds-body .build-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:30px 32px;border-bottom:1px solid var(--rule);text-decoration:none;color:inherit}
.builds-body .build-row:last-child{border-bottom:none}
.builds-body a.build-row:hover,.builds-body a.build-row:focus-visible{background:var(--stone)}
.builds-body .build-row .build-main{max-width:60ch}
.builds-body .build-row h3{font-size:19px;margin-bottom:8px}
.builds-body .build-row p{font-size:14.5px;line-height:1.6;color:var(--muted)}
.builds-body .build-status{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;padding-top:4px}
.builds-body .build-status.live{color:var(--accent-text)}
.builds-body .build-status.soon{color:var(--muted-2)}
.builds-body .build-row .arrow{font-family:var(--mono);color:var(--muted-2);padding-top:4px}

/* ---------- close ---------- */
.builds-body .close-sec{background:var(--ink);color:var(--paper);text-align:center;padding:96px 0}
.builds-body .close-sec .wordmark-line{font-size:22px;margin-bottom:18px;color:var(--paper)}
.builds-body .close-sec p{font-size:17px;line-height:1.7;max-width:46ch;margin:0 auto;color:#ffffffc0}
.builds-body .close-sec .q{margin-top:30px;font-family:var(--display);font-size:22px;color:var(--paper)}

.builds-body footer{padding:40px 0;border-top:1px solid var(--rule-soft)}
.builds-body .foot-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 26px;list-style:none;margin:0 0 18px;padding:0}
.builds-body .foot-nav a{font-family:var(--display);font-weight:600;font-size:14px;color:var(--ink);text-decoration:none}
.builds-body .foot-nav a:hover,.builds-body .foot-nav a:focus-visible{color:var(--accent-text)}
.builds-body .foot-legal{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:6px 14px;font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--muted-2);text-align:center}
.builds-body .foot-legal a{color:var(--muted-2);text-decoration:none}
.builds-body .foot-legal a:hover,.builds-body .foot-legal a:focus-visible{color:var(--ink)}
.builds-body .foot-legal .dot{opacity:.5}

/* ---------- print ---------- */
@media print{
  .builds-body .topnav{position:static}
  .builds-body .hero,.builds-body .close-sec{background:#fff !important;color:#111 !important}
  .builds-body .hero::before{display:none}
  .builds-body section{padding:36px 0;break-inside:avoid}
  .builds-body .bandlist{display:none}
  .builds-body .anatomy{grid-template-columns:1fr;border:none}
  .builds-body .anatomy-detail{padding:0}
  .builds-body .step-rail{display:none}
  .builds-body .stepper-shell{border:none}
  .builds-body .step-panel{padding:0}
  .builds-body .step-nav{display:none}
}
</style>
</head>
<body class="builds-body">

<!-- GLOBAL NAV -- matches Base.astro exactly (same wordmark, links, CTA)
     so this page reads as the same site, not a different one. -->
<nav class="sticky top-0 z-[9999] bg-[#0B0A09]/80 backdrop-blur-md border-b border-white/5">
