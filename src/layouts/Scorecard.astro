---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Readiness Diagnostic — Cobus van Vuuren',
  description = 'Benchmark your practice across 4 AI systems in 10 minutes. See exactly where you\'re leaving leverage on the table and which system to fix first.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="en_ZA" />

  <title>{title}</title>

  <!-- Fonts: Space Grotesk + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <slot name="head" />

  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KDZJDQR');</script>
</head>
<body class="antialiased">

  <!-- Background: same as Base for brand continuity -->
  <div class="bg-scene" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-orb bg-orb-crimson"></div>
    <div class="bg-orb bg-orb-warm"></div>
    <div class="bg-orb bg-orb-accent"></div>
  </div>

  <!-- Minimal trust bar — wordmark only, no nav escape during diagnostic -->
  <div class="fixed top-0 left-0 right-0 z-[9999] bg-[#0B0A09]/80 backdrop-blur-md border-b border-white/5">
    <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" style="font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:500;letter-spacing:0.06em;color:rgba(247,244,239,0.9);text-decoration:none;transition:color 0.2s;display:flex;align-items:center;gap:8px;">
        Cobus van Vuuren
        <span class="nav-cursor" aria-hidden="true"></span>
      </a>
      <span style="font-family:'Inter',sans-serif;font-size:10px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:#A67C52;display:flex;align-items:center;gap:8px;">
        <span style="width:20px;height:1px;background:#A67C52;display:inline-block;"></span>
        AI Readiness Diagnostic
      </span>
    </div>
  </div>

  <main class="relative z-[1] pt-[65px]">
    <slot />
  </main>

  <!-- SITEWIDE INTERACTIONS -->
  <script is:inline>
  (function () {
    // Scroll reveal
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-anim]').forEach(function (el) { obs.observe(el); });

    // Magnetic buttons (desktop only)
    if (window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll('.btn-primary, .btn-ghost-dark').forEach(function (btn) {
        btn.addEventListener('mousemove', function (e) {
          var r = btn.getBoundingClientRect();
          var x = ((e.clientX - r.left) / r.width - 0.5) * 9;
          var y = ((e.clientY - r.top) / r.height - 0.5) * 6;
          btn.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
          btn.style.transition = 'transform 0.1s ease';
        });
        btn.addEventListener('mouseleave', function () {
          btn.style.transform = '';
          btn.style.transition = 'transform 0.45s ease, background-color 0.2s ease, box-shadow 0.2s ease';
        });
      });
    }

    // Number counters (elements with data-count attribute)
    var countObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var target = parseFloat(el.dataset.count);
        var isFloat = !!el.dataset.countFloat;
        var dur = 1100;
        var start = performance.now();
        function tick(now) {
          var t = Math.min((now - start) / dur, 1);
          var eased = 1 - Math.pow(1 - t, 3);
          el.textContent = isFloat ? (eased * target).toFixed(1) : Math.round(eased * target);
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        countObs.unobserve(el);
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach(function (el) { countObs.observe(el); });
  })();
  </script>

</body>
</html>
