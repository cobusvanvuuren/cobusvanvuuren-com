---
import BuildsLayout from '../../layouts/BuildsLayout.astro';
import BuildCTA from '../../components/BuildCTA.astro';

const navLinks = [
  { href: '#problem', label: 'The problem' },
  { href: '#how', label: 'How it works' },
  { href: '#offers', label: 'What you get' },
];
---
<BuildsLayout
  title="Oxpecker — reads every review so nobody has to"
  description="Oxpecker reads a company's public reviews and surfaces the one real problem customers keep mentioning, or watches a competitor's reviews for you every month."
  navLinks={navLinks}
>

<!-- HERO -->
<header class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Review intelligence</p>
      <h1>Your customers already told you what's wrong. <em>Nobody read it.</em></h1>
      <p class="lede">Every business with real review volume has the same problem hiding in plain sight, repeated in a dozen different reviews, in a dozen different words, connected by nobody. Oxpecker reads every single one and hands you the one finding that matters.</p>
    </div>
    <div class="hero-mark-wrap">
      <img src="/images/marks/oxpecker-mark.png" alt="" class="hero-mark" width="180" height="180" />
      <img src="/images/marks/platforms/google.png" alt="Google" class="fly fly-1" width="28" height="28" />
      <img src="/images/marks/platforms/facebook.svg" alt="Facebook" class="fly fly-2" width="26" height="26" />
      <img src="/images/marks/platforms/trustpilot.svg" alt="Trustpilot" class="fly fly-3" width="26" height="26" />
      <img src="/images/marks/platforms/hellopeter.png" alt="Hellopeter" class="fly fly-4" width="28" height="28" />
    </div>
  </div>
</header>

<!-- PROBLEM -->
<section id="problem">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Before</p>
      <h2>Right now, your reviews are doing nothing for you except sitting there.</h2>
      <p>A new review comes in. Someone glances at the star rating. If it's bad, they reply and move on. If it's good, nobody even opens it. Multiply that by a hundred, three hundred, a thousand reviews, and the actual pattern underneath — the one thing customers keep circling back to, in their own words, unprompted — never gets pulled together. It's not hidden. It's just never been read as a whole.</p>
      <p>The same blind spot applies to a competitor. Their customers are telling the internet exactly what that business does well and where it drops the ball. That's sitting in public right now too. Nobody on your side is reading it either.</p>
    </div>
    <div class="premise-grid">
      <div class="col">
        <h3>What it's costing you</h3>
        <p>The customers who leave over the same recurring problem don't file a complaint. They just don't come back, and they don't tell you why. The only record of why is buried across reviews nobody's connected into one place.</p>
      </div>
      <div class="col">
        <h3>After Oxpecker</h3>
        <p>One clear answer: this is the specific thing your customers keep mentioning, here's the proof in their own words, and here's what it's actually costing you. Not a star-rating average. One finding you can act on this week.</p>
      </div>
    </div>
  </div>
</section>

<!-- BRIDGE -->
<section class="stone">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Bridge</p>
      <h2>Oxpecker is the difference between having reviews and actually using them.</h2>
      <p>It reads everything public, across every platform, and checks it against a judgment filter before anything gets called a finding. What comes back is one specific, provable problem, not a sentiment score nobody can act on.</p>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">What actually happens</p>
      <h2>Four steps, same process every time</h2>
    </div>
    <div class="workflow">
      <div class="workflow__toolbar">
        <span class="workflow__label">OXPECKER &middot; WORKFLOW PREVIEW</span>
        <span class="workflow__tag">SAMPLE DATA</span>
      </div>
      <p class="workflow__sub">Interactive sample &mdash; explore the workflow below. CVV runs your project and delivers the findings; no account or login is provided.</p>
      <div class="step-rail" id="stepRail" role="tablist"></div>
      <div class="workflow__body">
        <div class="workflow__explain" id="stepExplain"></div>
        <div class="workflow__workspace" id="stepWorkspace"></div>
      </div>
      <div class="step-nav">
        <button id="stepPrev" type="button">&larr; Previous step</button>
        <button id="stepNext" type="button">Next &rarr;</button>
      </div>
    </div>
  </div>
</section>

<!-- WHAT YOU GET -->
<section class="stone" id="offers">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Two ways to use it</p>
      <h2>A one-off finding, or an ongoing watch</h2>
      <p>Both run on the same engine. Which one fits depends on whether you want a single answer today, or an eye kept on this every month.</p>
    </div>
    <div class="offer-cards">
      <div class="offer-card">
        <p class="tag">One-off</p>
        <h4>Find the leak</h4>
        <p>We scan your business's public reviews and hand you one written finding: the single biggest recurring problem customers keep mentioning, with the quotes that back it up.</p>
        <p>Best for a business that's never had someone actually read all of its reviews in one place.</p>
      </div>
      <div class="offer-card">
        <p class="tag">Ongoing</p>
        <h4>Monthly watch</h4>
        <p>For businesses with real review volume: a monthly read on your own reviews (so nobody has to catch up on hundreds by hand), or a monthly watch on a named competitor — what their customers are saying now, not last quarter.</p>
        <p>Different signal to a traffic or ranking watch — this one is pure customer sentiment, straight from reviews.</p>
      </div>
    </div>

    <p class="explore-link"><a href="#how" id="jumpToFinding">See a real sample finding, worked through the 4 steps &uarr;</a></p>
  </div>
</section>

<!-- PROOF -->
<section id="proof">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">What's actually been validated</p>
      <h2>Said plainly, not oversold</h2>
    </div>
    <div class="proof-box">
      Run on <span class="stat">8</span> real South African companies. Surfaced <span class="stat">33</span> real findings. Not yet run for a paying client — every number above is from validation runs, not a live engagement. We'll say exactly that until it changes.
    </div>
  </div>
</section>

<!-- CTA -->
<BuildCTA headline="Point this at your business and see what's actually in your reviews." linkText="Get this for your business" href="/score/" />

<!-- CLOSE -->
<section class="close-sec">
  <div class="wrap">
    <img src="/images/marks/oxpecker-mark.png" alt="" class="close-mark" width="48" height="48" />
    <p class="wordmark-line">Oxpecker</p>
    <p>Named for the bird that rides large animals and eats what everyone else misses.</p>
    <p class="q">What's your review history actually saying, that nobody's connected yet?</p>
  </div>
</section>

<script is:inline>
(function(){
  // One consistent illustrative dataset across all 4 steps -- per the
  // 2026-09-15 design consultation (GPT-6 Astra): software changes the
  // state of an object (a source becomes a dataset, becomes clusters,
  // becomes a finding), it doesn't just swap explanatory paragraphs.
  var EXCERPTS = [
    {src:"Google", age:"3wk ago", text:"Quoted us Tuesday, didn't hear back for a week.", theme:"response"},
    {src:"Hellopeter", age:"1mo ago", text:"Had to phone twice to find out if they were still coming.", theme:"response"},
    {src:"Facebook", age:"2mo ago", text:"Great work once they started, just took forever to confirm.", theme:"response"},
    {src:"Google", age:"2mo ago", text:"Went quiet after the site visit, we booked someone else.", theme:"response"}
  ];
  var THEMES = [
    {name:"Response time after quote", count:14, primary:true},
    {name:"Work quality (positive)", count:22, primary:false},
    {name:"Price transparency", count:6, primary:false},
    {name:"Scheduling changes", count:5, primary:false}
  ];
  var FINDING = {
    id:"F-01",
    theme:"Response time after quote",
    observation:"14 of the last 40 reviews mention slow follow-up after the initial quote, not the quote itself. Customers describe it as “went quiet” or “had to chase them.” None of the 5-star reviews mention this, so it only shows up once someone has already decided not to come back.",
    action:"Set a same-day acknowledgement rule for every quote, even if the real answer comes later."
  };

  var steps = [
    {n:"01", name:"Point", h:"Tell us the business", p:"A name and, if you have them, the review platform URLs — Oxpecker can usually find the rest on its own.", nextLabel:"Next: Ingest", type:"point"},
    {n:"02", name:"Ingest", h:"Every public review, pulled in", p:"Google, Hellopeter, Trustpilot, Facebook — whatever the business actually has, read in full, not sampled.", nextLabel:"Next: Cluster", type:"ingest"},
    {n:"03", name:"Cluster", h:"Grouped into real themes", p:"Individual complaints and compliments get grouped into the actual recurring patterns underneath them, not just tallied by star rating.", nextLabel:"Next: Surface", type:"cluster"},
    {n:"04", name:"Surface", h:"One finding, checked before it ships", p:"The single most significant theme is written up and checked against a judgment filter before you ever see it — if there isn't enough real data, Oxpecker says so instead of forcing a thin finding.", nextLabel:"Start again", type:"surface"}
  ];

  var rail = document.getElementById('stepRail');
  var explain = document.getElementById('stepExplain');
  var workspace = document.getElementById('stepWorkspace');
  var prevBtn = document.getElementById('stepPrev');
  var nextBtn = document.getElementById('stepNext');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var current = 0;

  steps.forEach(function(s, i){
    var tab = document.createElement('button');
    tab.className = 'step-tab';
    tab.type = 'button';
    tab.setAttribute('role','tab');
    tab.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
    tab.setAttribute('aria-controls', 'stepWorkspace');
    tab.id = 'step-tab-' + i;
    tab.innerHTML = '<span class="n">' + s.n + '</span>' + s.name;
    tab.addEventListener('click', function(){ selectStep(i, true); });
    tab.addEventListener('keydown', function(e){
      if (e.key === 'ArrowRight') { selectStep(Math.min(i+1, steps.length-1), true); }
      if (e.key === 'ArrowLeft')  { selectStep(Math.max(i-1, 0), true); }
    });
    rail.appendChild(tab);
  });

  function renderWorkspace(type){
    if (type === 'point') {
      return '<div class="ws-field"><span class="ws-label">Business</span><span class="ws-value">Example Home Services Co.</span></div>' +
             '<div class="ws-field"><span class="ws-label">Sources</span><span class="ws-value">Google &middot; Hellopeter &middot; Facebook</span></div>' +
             '<div class="ws-field"><span class="ws-label">Period</span><span class="ws-value">Last 12 months &middot; 214 reviews</span></div>';
    }
    if (type === 'ingest') {
      return '<ul class="ws-excerpt-list">' + EXCERPTS.map(function(e){
        return '<li><span class="ws-src">' + e.src + ' &middot; ' + e.age + '</span><p>“' + e.text + '”</p></li>';
      }).join('') + '</ul>';
    }
    if (type === 'cluster') {
      return '<ul class="ws-theme-list">' + THEMES.map(function(t){
        return '<li class="' + (t.primary ? 'primary' : '') + '"><span class="ws-theme-name">' + t.name + '</span><span class="ws-theme-count">' + t.count + ' mentions</span></li>';
      }).join('') + '</ul>';
    }
    if (type === 'surface') {
      return '<div class="finding" id="findingCard">' +
        '<div class="finding-head"><span class="finding-id">' + FINDING.id + '</span><span class="finding-theme">' + FINDING.theme + '</span></div>' +
        '<p class="finding-field"><strong>Observation</strong>' + FINDING.observation + '</p>' +
        '<button type="button" class="finding-toggle" id="findingToggle" aria-expanded="false">Show supporting excerpts</button>' +
        '<div class="finding-excerpts" id="findingExcerpts" hidden>' + EXCERPTS.filter(function(e){return e.theme==='response';}).map(function(e){
          return '<p>“' + e.text + '” <span>&mdash; ' + e.src + '</span></p>';
        }).join('') + '</div>' +
        '<p class="finding-field"><strong>Recommended next step</strong>' + FINDING.action + '</p>' +
        '<button type="button" class="finding-copy" id="findingCopy">Copy finding</button>' +
      '</div>';
    }
    return '';
  }

  function bindWorkspaceControls(){
    var toggle = document.getElementById('findingToggle');
    if (toggle) {
      toggle.addEventListener('click', function(){
        var panel = document.getElementById('findingExcerpts');
        var open = panel.hasAttribute('hidden');
        if (open) { panel.removeAttribute('hidden'); toggle.setAttribute('aria-expanded','true'); toggle.textContent = 'Hide supporting excerpts'; }
        else { panel.setAttribute('hidden',''); toggle.setAttribute('aria-expanded','false'); toggle.textContent = 'Show supporting excerpts'; }
      });
    }
    var copy = document.getElementById('findingCopy');
    if (copy) {
      copy.addEventListener('click', function(){
        var text = FINDING.theme + '\n\n' + FINDING.observation + '\n\nRecommended next step: ' + FINDING.action;
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text).then(function(){
            var orig = copy.textContent;
            copy.textContent = 'Copied';
            setTimeout(function(){ copy.textContent = orig; }, 1600);
          });
        }
      });
    }
  }

  function selectStep(i, scrollRail){
    current = i;
    steps.forEach(function(s, j){
      document.getElementById('step-tab-' + j).setAttribute('aria-selected', j === i ? 'true' : 'false');
    });
    var s = steps[i];
    explain.innerHTML = '<h3>' + s.n + ' &middot; ' + s.h + '</h3><p>' + s.p + '</p>';
    var wsHtml = renderWorkspace(s.type);
    if (reduceMotion) {
      workspace.innerHTML = wsHtml;
    } else {
      workspace.style.opacity = '0';
      workspace.style.transform = 'translateY(6px)';
      workspace.innerHTML = wsHtml;
      requestAnimationFrame(function(){
        workspace.style.transition = 'opacity 160ms ease, transform 160ms ease';
        workspace.style.opacity = '1';
        workspace.style.transform = 'translateY(0)';
      });
    }
    bindWorkspaceControls();
    prevBtn.disabled = i === 0;
    nextBtn.textContent = (i === steps.length - 1 ? 'Start again' : s.nextLabel) + (i === steps.length - 1 ? '' : ' →');
    if (scrollRail) {
      document.getElementById('step-tab-' + i).scrollIntoView({block:'nearest', inline:'center', behavior:'smooth'});
    }
  }
  prevBtn.addEventListener('click', function(){ if(current > 0) selectStep(current - 1, true); });
  nextBtn.addEventListener('click', function(){
    if (current === steps.length - 1) { selectStep(0, true); }
    else { selectStep(current + 1, true); }
  });
  selectStep(0, false);

  var jumpLink = document.getElementById('jumpToFinding');
  if (jumpLink) {
    jumpLink.addEventListener('click', function(e){
      e.preventDefault();
      selectStep(3, true);
      document.getElementById('how').scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth'});
    });
  }
})();
</script>

</BuildsLayout>
