---
import BuildsLayout from '../../layouts/BuildsLayout.astro';
import BuildCTA from '../../components/BuildCTA.astro';
import { featuredPages as featured } from '../../data/ai-automation-pages.js';

const alsoAvailable = [
  { name: 'FAQ Harvest', note: 'Finds the real questions customers are searching for and turns your own answers into content.' },
  { name: 'Root Cause', note: 'Drills from a surface symptom down to the real cause, instead of fixing the same problem twice.' },
  { name: 'Image Engine', note: 'On-brand, audience-targeted visuals produced at batch scale.' },
  { name: 'POP Watchdog', note: 'Monthly technical SEO fixes, found and applied, not just flagged.' },
  { name: 'Google Ads Audit', note: 'A weekly read on what your Google Ads account is actually doing.' },
  { name: 'Meta Ads Audit', note: 'The same weekly discipline, for Facebook and Instagram ads.' },
  { name: 'AI Visibility Audit', note: 'Checks whether your business shows up when someone asks ChatGPT instead of Google.' },
  { name: 'SEO Technical Audit', note: 'A full technical health check across 16 real ranking factors.' },
  { name: 'Target Market / ICP Research', note: 'Builds a real picture of who actually buys, not a guess.' },
  { name: 'ELRIN', note: 'Keeps your systems current with what\'s actually working elsewhere.' },
  { name: 'Sales Call Intelligence', note: 'Checks a sales call for what was promised against what\'s actually true.' },
  { name: 'Voice Winners', note: 'Learns which of your own posts actually performed, and writes more like those.' },
  { name: 'Local SEO Audit', note: 'Checks whether your business is set up to win the map pack.' },
  { name: 'LLM Profile Page', note: 'A page built specifically to be read and cited by AI answer engines.' },
  { name: 'Automated Financial Reporting', note: 'A weekly and monthly read on the numbers, without anyone pulling a spreadsheet.' },
  { name: 'Automated Business Reviews', note: 'A standing pulse on the state of the business, without anyone assembling it by hand.' },
  { name: 'Strategic Advisory Suite', note: 'A structured second opinion or stress-test before a big decision, on demand.' },
  { name: 'Client Memory System', note: 'A structured, queryable memory of your business built over time, so nothing has to be re-explained to a new hire or a new tool.' },
  { name: 'Managed Agents', note: 'An ongoing, managed AI agent running a defined part of your operations, on retainer.' },
  { name: 'Automation Engine', note: 'Custom-built automation for a specific repeatable process unique to your business.' },
  { name: 'Speed-to-Lead / Instant Response Agents', note: 'Responds to a new enquiry within minutes, any time of day, before a competitor does.' },
  { name: 'Automated AR & Invoicing Follow-ups', note: 'Chases overdue invoices and payments automatically, without an awkward phone call.' },
  { name: 'Internal Knowledge & Meeting Summarizers', note: 'Turns meetings and internal knowledge into searchable, structured notes automatically.' },
  { name: 'AI Customer Support', note: 'Handles common customer questions automatically, escalating only what actually needs a person.' },
  { name: 'Smart Document Processing', note: 'Reads and extracts data from documents automatically, instead of manual data entry.' },
  { name: 'Automated Meeting Transcripts', note: 'A full, searchable transcript of every meeting, without anyone taking notes.' },
];

const iconCluster = featured.map((f) => f.icon);
---
<BuildsLayout
  title="AI Automation — systems that already run parts of real businesses"
  description="A running list of real systems built for real businesses, plus a few CVV can build for yours."
  navLinks={[{ href: '#featured', label: 'Featured' }, { href: '#also-available', label: 'Also available' }]}
>

<!-- HERO -->
<header class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Systems, not one-off projects</p>
      <h1>Systems that already run parts of real businesses &mdash; plus a few we can <em>build for yours</em>.</h1>
      <p class="lede">Each Featured system below is currently doing a real part of how a real business operates, explained the same way it's actually built. Everything else CVV has built, or can build next, is listed honestly further down &mdash; some already delivering results, a few not built yet.</p>
    </div>
    <div class="icon-cluster">
      {iconCluster.map((src) => <img src={src} alt="" width="56" height="56" />)}
    </div>
  </div>
</header>

<!-- PROBLEM / DREAM OUTCOME -->
<section id="intro">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Why this list exists</p>
      <h2>Most of what gets called an "AI system" is a demo. These run every week.</h2>
    </div>
    <div class="premise-grid">
      <div class="col">
        <h3>The bottleneck you recognise</h3>
        <p>Something in the business runs on memory, manual checking, or whoever has ten minutes today &mdash; not a real process. It works, until it doesn't, and nobody notices until it's already cost something.</p>
      </div>
      <div class="col">
        <h3>Once it's gone</h3>
        <p>The same work runs on a system instead, with a real process behind it that doesn't depend on someone remembering to do it. Not software you log into &mdash; a system run for you, by a person.</p>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED GRID -->
<section class="stone" id="featured">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Window shopping</p>
      <h2>Featured</h2>
      <p>Real systems, each with its own page: what it does, how it works, and what's actually been validated.</p>
    </div>
    <div class="featured-grid">
      {featured.map((f) => (
        <a class="featured-card" href={f.href}>
          <img src={f.icon} alt="" class="card-icon" width="40" height="40" />
          <h3>{f.name}</h3>
          <p class="outcome">{f.outcome}</p>
          <p class="problem">{f.problem}</p>
          <span class="arrow">Read more &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ALSO AVAILABLE -->
<section id="also-available">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Also available</p>
      <h2>Install any of these for your business</h2>
      <p>Real work CVV has already built, plus what else is genuinely possible to build next. None of it has its own page here, so what it does is explained in one line instead.</p>
    </div>

    <div class="also-available">
      <div class="also-list">
        {alsoAvailable.map((item) => (
          <div class="also-row">
            <span class="name">{item.name}</span>
            <span class="note">{item.note}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<BuildCTA headline="Not sure which one? Start with the free diagnostic." />

</BuildsLayout>
