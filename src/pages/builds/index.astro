---
import BuildsLayout from '../../layouts/BuildsLayout.astro';
import BuildCTA from '../../components/BuildCTA.astro';

const builds = [
  {
    name: 'Okapi',
    tag: 'The foundation',
    status: 'live',
    href: '/builds/okapi/',
    desc: 'A file-based operating system for running a business day to day — the layer the systems below are built on top of.',
  },
  {
    name: 'Spoorsny',
    tag: 'Data layer',
    status: 'soon',
    desc: 'One connector that pulls every marketing data source, analytics, search console, ad platforms, rank tracking, into a single place instead of ten different logins.',
  },
  {
    name: 'Oxpecker',
    tag: 'Review mining',
    status: 'soon',
    desc: "Reads a company's own public reviews and surfaces the one operational leak customers keep mentioning, before anyone has to ask them directly.",
  },
  {
    name: 'Meerkat',
    tag: 'Competitor watch',
    status: 'soon',
    desc: "A quiet watchlist that flags when a competitor's traffic, rankings, or backlink profile move enough to be worth a second look.",
  },
  {
    name: 'Hamerkop',
    tag: 'Lead-gen sites',
    status: 'soon',
    desc: 'Picks a real, underserved local-service niche, builds and ranks a small lead-generation site for it, then hands the leads to a real operator.',
  },
];
---
<BuildsLayout
  title="Builds — systems actually running a business, not just prototypes"
  description="A running list of the systems built to run RhinoBerry and its clients — explained the same way they're actually built, not as marketing case studies."
  wordmark="Builds"
>

<!-- HERO -->
<header class="hero">
  <div class="wrap">
    <p class="eyebrow">Systems, not one-off projects</p>
    <h1>Business systems, <em>actually running</em> businesses.</h1>
    <p class="lede">These aren't case studies about someone else's work. Each one below is a system currently doing a real part of how RhinoBerry and its clients operate, explained the same way it's actually built.</p>
  </div>
</header>

<!-- INTRO -->
<section id="intro">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Why this list exists</p>
      <h2>Most of what gets called an "AI system" is a demo. These run every week.</h2>
      <p>Each entry here started as a specific, boring business problem, not a technology choice. Some are live and documented in full below; others are running but not yet written up. The list grows as each one gets its own page.</p>
    </div>
  </div>
</section>

<!-- BUILD LIST -->
<section class="stone" id="list">
  <div class="wrap">
    <div class="buildlist">
      {builds.map((b) => {
        const inner = (
          <>
            <div class="build-main">
              <p class="eyebrow">{b.tag}</p>
              <h3>{b.name}</h3>
              <p>{b.desc}</p>
            </div>
            <div>
              <p class={`build-status ${b.status}`}>{b.status === 'live' ? 'Live' : 'In progress'}</p>
              {b.status === 'live' && <p class="arrow">&rarr;</p>}
            </div>
          </>
        );
        return b.status === 'live' ? (
          <a class="build-row" href={b.href}>{inner}</a>
        ) : (
          <div class="build-row">{inner}</div>
        );
      })}
    </div>
  </div>
</section>

<!-- CTA -->
<BuildCTA headline="Every one of these started as a business problem, not a technology decision. If yours needs the same kind of system, the diagnostic is where it starts." />

</BuildsLayout>
