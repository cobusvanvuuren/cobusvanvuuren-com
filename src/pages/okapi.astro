---
// Okapi Showcase — standalone page, deliberately not using Base.astro.
// Ported verbatim from the source build (RhinoBerry Okapi repo,
// projects/rhinoberry/brand/2026-09-10_build_okapi-showcase.html) so it
// renders and behaves identically to the original: own fonts, own reset,
// own Performance Mono brand tokens, own nav/footer. Base.astro's nav,
// footer, fonts and background scene are intentionally not applied here.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Okapi is a file-based operating system for running a business day to day — plain files instead of a database only one vendor can read.">
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" href="/favicon.png" />
<title>Okapi — a system built to run a business, not just answer questions</title>
<meta property="og:title" content="Okapi — a system built to run a business, not just answer questions" />
<meta property="og:description" content="A file-based operating system for running a business day to day — plain files instead of a database only one vendor can read." />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<style is:inline>
:root{
  --ink:#111111; --paper:#FFFFFF; --stone:#F1F1EF; --accent:#FF4A1C;
  --accent-text:#C93A13; /* darkened accent — small text on light backgrounds needs 4.5:1, #FF4A1C only clears ~3.4:1 there */
  --rule:#dedede; --rule-soft:#e8e8e6; --muted:#5a5a58; --muted-2:#8a8a85;
  --display:'Space Grotesk',system-ui,sans-serif;
  --body:'Inter',system-ui,-apple-system,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);-webkit-font-smoothing:antialiased;line-height:1.5}
h1,h2,h3,h4{font-family:var(--display);font-weight:700;letter-spacing:-.02em;margin:0}
p{margin:0}
a{color:inherit}
button{font-family:inherit;cursor:pointer}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2)}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* ---------- top nav ---------- */
.topnav{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);border-bottom:1px solid var(--rule)}
.topnav .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;gap:16px}
.wordmark{font-family:var(--display);font-weight:700;font-size:18px;letter-spacing:-.02em}
.navlinks{display:flex;gap:22px;list-style:none;margin:0;padding:0;font-size:13px}
.navlinks a{text-decoration:none;color:var(--muted);border-bottom:1px solid transparent;padding-bottom:2px}
.navlinks a:hover,.navlinks a:focus-visible{color:var(--ink);border-color:var(--accent)}
@media(max-width:720px){.navlinks{display:none}}

/* ---------- hero ---------- */
.hero{background:var(--ink);color:var(--paper);position:relative;overflow:hidden;padding:120px 0 96px}
.hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(#ffffff14 1px,transparent 1px);background-size:22px 22px;pointer-events:none}
.hero .wrap{position:relative}
.hero .eyebrow{color:#ffffff85}
.hero h1{font-size:clamp(34px,5.4vw,58px);line-height:1.06;max-width:15ch;margin:18px 0 26px}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p.lede{font-size:18px;line-height:1.65;max-width:56ch;color:#ffffffc0;margin-bottom:0}

/* ---------- section shell ---------- */
section{padding:88px 0;border-bottom:1px solid var(--rule-soft)}
section.stone{background:var(--stone)}
.sec-head{max-width:64ch;margin-bottom:48px}
.sec-head h2{font-size:clamp(24px,3vw,34px);margin-bottom:14px}
.sec-head p{font-size:16px;line-height:1.65;color:var(--muted)}

/* ---------- 01 premise ---------- */
.premise-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
@media(max-width:760px){.premise-grid{grid-template-columns:1fr}}
.premise-grid .col h3{font-family:var(--mono);font-weight:600;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:14px}
.premise-grid .col p{font-size:15.5px;line-height:1.7;color:var(--ink)}
.premise-grid .col p + p{margin-top:12px}

/* ---------- 02 anatomy ---------- */
.anatomy{display:grid;grid-template-columns:340px 1fr;gap:0;border:1px solid var(--rule)}
@media(max-width:800px){.anatomy{grid-template-columns:1fr}}
.bandlist{list-style:none;margin:0;padding:0;border-right:1px solid var(--rule)}
@media(max-width:800px){.bandlist{border-right:none;border-bottom:1px solid var(--rule)}}
.bandlist li{border-bottom:1px solid var(--rule)}
.bandlist li:last-child{border-bottom:none}
.band-btn{display:flex;align-items:center;gap:14px;width:100%;background:var(--paper);border:none;text-align:left;padding:18px 22px;transition:background .12s ease}
.band-btn:hover{background:var(--stone)}
.band-btn[aria-selected="true"]{background:var(--ink);color:var(--paper)}
.band-num{font-family:var(--mono);font-size:11px;color:var(--muted-2);min-width:22px}
.band-btn[aria-selected="true"] .band-num{color:#ffffff70}
.band-name{font-family:var(--display);font-weight:700;font-size:15.5px}
.anatomy-detail{padding:36px 40px;background:var(--paper)}
.anatomy-detail .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-text);margin-bottom:10px}
.anatomy-detail h3{font-size:24px;margin-bottom:14px}
.anatomy-detail .answers{font-size:15px;line-height:1.7;color:var(--muted);margin-bottom:18px}
.anatomy-detail .lives-in{font-size:13.5px;line-height:1.6;color:var(--ink);margin-bottom:16px}
.anatomy-detail .lives-in strong{font-family:var(--mono);font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2);display:block;margin-bottom:6px}
.mech{border-top:1px solid var(--rule-soft);padding-top:16px;font-size:14px;line-height:1.65;font-style:italic;color:var(--ink)}

/* ---------- 03 stepper ---------- */
.stepper-shell{border:1px solid var(--rule)}
.step-rail{display:flex;overflow-x:auto;border-bottom:1px solid var(--rule);background:var(--stone)}
.step-tab{flex:1 0 auto;min-width:104px;padding:14px 10px;background:transparent;border:none;border-right:1px solid var(--rule);text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--muted)}
.step-tab:last-child{border-right:none}
.step-tab .n{display:block;font-size:10px;color:var(--muted-2);margin-bottom:4px}
.step-tab[aria-selected="true"]{background:var(--ink);color:var(--paper)}
.step-tab[aria-selected="true"] .n{color:var(--accent)}
.step-panel{padding:40px}
.step-panel h3{font-size:22px;margin-bottom:12px}
.step-panel p{font-size:15px;line-height:1.7;color:var(--muted);max-width:60ch}
.step-nav{display:flex;justify-content:space-between;padding:0 40px 32px}
.step-nav button{background:var(--ink);color:var(--paper);border:none;padding:11px 20px;font-size:13px;font-weight:500}
.step-nav button:disabled{opacity:.3;cursor:default}
.step-nav button:not(:disabled):hover{background:var(--accent)}

/* ---------- 04 loop ---------- */
.loop-wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
@media(max-width:780px){.loop-wrap{grid-template-columns:1fr}}
.loop-svg{width:100%;height:auto}
.loop-node-label{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;fill:var(--ink)}
.loop-copy p{font-size:15.5px;line-height:1.75;color:var(--muted)}
.loop-copy p + p{margin-top:16px}
.loop-copy strong{color:var(--ink)}
@media(prefers-reduced-motion: no-preference){
  .loop-stroke{stroke-dasharray:8 6;animation:dash 5s linear infinite}
}
@keyframes dash{to{stroke-dashoffset:-140}}

/* ---------- 05 guardrails ---------- */
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)}
@media(max-width:820px){.tiles{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.tiles{grid-template-columns:1fr}}
.tile{background:var(--paper);padding:28px 26px}
.tile .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-text);margin-bottom:10px}
.tile h4{font-size:16px;margin-bottom:10px;line-height:1.3}
.tile p{font-size:13.5px;line-height:1.6;color:var(--muted)}

/* ---------- 06 isn't ---------- */
.isnt{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--rule)}
@media(max-width:700px){.isnt{grid-template-columns:1fr}}
.isnt .col{padding:36px 40px}
.isnt .col:first-child{border-right:1px solid var(--rule);background:var(--stone)}
@media(max-width:700px){.isnt .col:first-child{border-right:none;border-bottom:1px solid var(--rule)}}
.isnt h3{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2);margin-bottom:20px}
.isnt ul{list-style:none;margin:0;padding:0}
.isnt li{font-size:15.5px;line-height:1.7;padding:10px 0;border-bottom:1px dotted var(--rule)}
.isnt li:last-child{border-bottom:none}
.isnt .col:first-child li{color:var(--muted);text-decoration:line-through;text-decoration-color:#c8c8c4}
.isnt .col:last-child li{color:var(--ink);font-weight:500}
.portability{margin-top:28px;padding-top:22px;border-top:1px solid var(--rule);font-size:14px;line-height:1.65;color:var(--muted)}

/* ---------- close ---------- */
.close-sec{background:var(--ink);color:var(--paper);text-align:center;padding:96px 0}
.close-sec .wordmark{font-size:22px;margin-bottom:18px}
.close-sec p{font-size:17px;line-height:1.7;max-width:46ch;margin:0 auto;color:#ffffffc0}
.close-sec .q{margin-top:30px;font-family:var(--display);font-size:22px;color:var(--paper)}

footer{padding:28px 0;text-align:center}
footer p{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--muted-2)}

/* ---------- print ---------- */
@media print{
  .topnav{position:static}
  .hero,.close-sec{background:#fff !important;color:#111 !important}
  .hero::before{display:none}
  section{padding:36px 0;break-inside:avoid}
  .bandlist{display:none}
  .anatomy{grid-template-columns:1fr;border:none}
  .anatomy-detail{padding:0}
  .step-rail{display:none}
  .stepper-shell{border:none}
  .step-panel{padding:0}
  .step-nav{display:none}
}
</style>
</head>
<body>

<nav class="topnav">
  <div class="wrap">
    <span class="wordmark">Okapi</span>
    <ul class="navlinks">
      <li><a href="#anatomy">Anatomy</a></li>
      <li><a href="#job">How a job runs</a></li>
      <li><a href="#loop">The loop</a></li>
      <li><a href="#guardrails">Guardrails</a></li>
      <li><a href="#isnt">What it isn't</a></li>
    </ul>
  </div>
</nav>

<!-- 00 HERO -->
<header class="hero">
  <div class="wrap">
    <p class="eyebrow">A file-based operating system</p>
    <h1>A business, run by something that <em>writes down</em> everything it does.</h1>
    <p class="lede">Okapi is not a dashboard, not a bot, and not a folder of clever prompts. It is an operating system for running a business day to day, built from plain files instead of a database only one vendor can read.</p>
  </div>
</header>

<!-- 01 PREMISE -->
<section id="premise">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Why it's built this way</p>
      <h2>Software assumes the process is already known. Most businesses don't have one written down.</h2>
      <p>Most small operations run on memory: what the owner remembers, what the one long-tenured employee remembers, what got done last time so it probably gets done the same way this time. That works until someone is unreachable for a week and nothing moves. Okapi starts from the opposite assumption: write the process down first, then let something reliable execute it.</p>
    </div>
    <div class="premise-grid">
      <div class="col">
        <h3>The old way</h3>
        <p>Knowledge lives in one person's head. A new hire, a locked-in SaaS tool, or a bad week takes the whole operation down with it.</p>
        <p>Software gets bought to fix this, and instead adds a login, a training cost, and a vendor who owns the data.</p>
      </div>
      <div class="col">
        <h3>The Okapi way</h3>
        <p>Every method, every decision, every correction is a file. Plain text and a handful of small databases, readable by any tool, owned by the business that built it.</p>
        <p>Because it's just files, nothing about it depends on one AI vendor staying in business. Swap the model underneath and the system keeps running.</p>
      </div>
    </div>
  </div>
</section>

<!-- 02 ANATOMY -->
<section class="stone" id="anatomy">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">What's actually in it</p>
      <h2>Seven layers, each answering a different question</h2>
      <p>Click a layer to open it. These aren't invented categories for this page — they're the actual folder names the system runs on.</p>
    </div>

    <div class="anatomy">
      <ul class="bandlist" role="tablist" aria-label="Okapi layers" id="bandList"></ul>
      <div class="anatomy-detail" id="anatomyDetail" role="tabpanel"></div>
    </div>
  </div>
</section>

<!-- 03 ONE JOB END TO END -->
<section id="job">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">What happens when it runs</p>
      <h2>One request, travelling the whole system</h2>
      <p>Nothing here is hypothetical — this is the literal path a request takes, from being asked to being remembered. Step through it.</p>
    </div>

    <div class="stepper-shell">
      <div class="step-rail" role="tablist" aria-label="Job steps" id="stepRail"></div>
      <div class="step-panel" id="stepPanel" role="tabpanel"></div>
      <div class="step-nav">
        <button type="button" id="stepPrev">Previous</button>
        <button type="button" id="stepNext">Next</button>
      </div>
    </div>
  </div>
</section>

<!-- 04 THE LOOP -->
<section class="stone" id="loop">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Why it improves instead of decaying</p>
      <h2>The loop that closes</h2>
    </div>
    <div class="loop-wrap">
      <svg class="loop-svg" viewBox="0 0 360 360" role="img" aria-label="A four-step cycle: Do, Log, Mine, Rewrite, connected in a continuous loop">
        <circle cx="180" cy="180" r="130" fill="none" stroke="#dedede" stroke-width="1"/>
        <circle class="loop-stroke" cx="180" cy="180" r="130" fill="none" stroke="#FF4A1C" stroke-width="2"/>
        <g>
          <circle cx="180" cy="50" r="34" fill="#111111"/>
          <text x="180" y="55" text-anchor="middle" fill="#fff" font-family="Space Grotesk" font-weight="700" font-size="13">Do</text>
          <text class="loop-node-label" x="180" y="18" text-anchor="middle">work happens</text>
        </g>
        <g>
          <circle cx="310" cy="180" r="34" fill="#111111"/>
          <text x="310" y="185" text-anchor="middle" fill="#fff" font-family="Space Grotesk" font-weight="700" font-size="13">Log</text>
          <text class="loop-node-label" x="310" y="228" text-anchor="middle">the record</text>
        </g>
        <g>
          <circle cx="180" cy="310" r="34" fill="#111111"/>
          <text x="180" y="315" text-anchor="middle" fill="#fff" font-family="Space Grotesk" font-weight="700" font-size="13">Mine</text>
          <text class="loop-node-label" x="180" y="352" text-anchor="middle">the pattern</text>
        </g>
        <g>
          <circle cx="50" cy="180" r="34" fill="#111111"/>
          <text x="50" y="185" text-anchor="middle" fill="#fff" font-family="Space Grotesk" font-weight="700" font-size="13">Rewrite</text>
          <text class="loop-node-label" x="50" y="228" text-anchor="middle">the method</text>
        </g>
      </svg>
      <div class="loop-copy">
        <p>Most systems rot quietly. A method gets written once, nobody revisits it, and six months later it's wrong in ways no one notices until something breaks.</p>
        <p>Okapi treats a mistake as data, not an embarrassment. Every session leaves behind a record of what was asked, what was delivered, and what had to be corrected. <strong>That record gets read back on a fixed cadence</strong> — patterns get mined out of it, and the method file that caused the mistake gets rewritten, not just the one output.</p>
        <p>The result is a system whose oldest parts are its most battle-tested, not its most neglected.</p>
      </div>
    </div>
  </div>
</section>

<!-- 05 GUARDRAILS -->
<section id="guardrails">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">What stops it doing something stupid</p>
      <h2>Guardrails, not good intentions</h2>
      <p>None of these are a policy written on a page and hoped for. Each one is a mechanical check, run before the risky step, not after.</p>
    </div>
    <div class="tiles">
      <div class="tile">
        <p class="tag">Before it runs</p>
        <h4>Mechanical hooks</h4>
        <p>Certain actions — publishing, spending, deleting, touching live infrastructure — are intercepted before they execute, not reviewed after the fact.</p>
      </div>
      <div class="tile">
        <p class="tag">Before it ships</p>
        <h4>Human approval gates</h4>
        <p>Anything that publishes externally or sends to a real person stages first and waits for a yes. The system drafts; a person decides what goes out.</p>
      </div>
      <div class="tile">
        <p class="tag">Reading untrusted input</p>
        <h4>Quarantine by default</h4>
        <p>Anything arriving from outside the system — an email, a scraped page, a flagged file — is read as data to summarise, never as an instruction to follow.</p>
      </div>
      <div class="tile">
        <p class="tag">Making a claim</p>
        <h4>Confidence scoring</h4>
        <p>Every diagnosis or recommendation can be asked to rate its own certainty. A wrong confident answer is treated as worse than an honest "I don't know."</p>
      </div>
      <div class="tile">
        <p class="tag">Before committing</p>
        <h4>Argue the other side first</h4>
        <p>Any significant recommendation has to survive its own strongest counter-argument, written out loud, before it's allowed to be the final answer.</p>
      </div>
      <div class="tile">
        <p class="tag">Citing anything</p>
        <h4>Source provenance</h4>
        <p>A date-sensitive claim or a quoted line has to trace back to a real, checkable source before it's allowed to be presented as fact.</p>
      </div>
    </div>
  </div>
</section>

<!-- 06 WHAT IT ISN'T -->
<section class="stone" id="isnt">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">For comparison</p>
      <h2>What it isn't</h2>
    </div>
    <div class="isnt">
      <div class="col">
        <h3>Not this</h3>
        <ul>
          <li>A dashboard you have to check</li>
          <li>A SaaS product with a login and a monthly bill</li>
          <li>A chatbot that forgets everything between conversations</li>
          <li>A folder of clever prompts held together by hope</li>
        </ul>
      </div>
      <div class="col">
        <h3>This instead</h3>
        <ul>
          <li>An operator that reads its own state before doing anything</li>
          <li>An asset the business owns outright</li>
          <li>A system with a permanent, growing memory</li>
          <li>Encoded procedure, invoked by name, improved on a schedule</li>
        </ul>
      </div>
    </div>
    <p class="portability">Underneath it all: plain text files, a handful of small databases, and open integration standards rather than a proprietary format. Nothing about how it's stored requires any single company to keep existing.</p>
  </div>
</section>

<!-- 07 CLOSE -->
<section class="close-sec">
  <div class="wrap">
    <p class="wordmark">Okapi</p>
    <p>Built to run a business the way a careful operator would, if that operator never forgot anything and never stopped writing it down.</p>
    <p class="q">What would you build if nothing you did this week had to be redone next month?</p>
  </div>
</section>

<footer>
  <p class="wrap">RHINOBERRY &middot; OKAPI OPERATING SYSTEM</p>
</footer>

<script is:inline>
(function(){
  var bands = [
    {
      name:"Identity", tag:"Layer 1",
      answers:"Who this is, what it stands for, and how the operator behind it actually thinks.",
      livesIn:"A single identity file and a beliefs file — voice, values, market context, and the operator's own decision patterns.",
      mech:"Every session reads this before touching anything else, so tone and judgment stay consistent even across a long gap between sessions."
    },
    {
      name:"State", tag:"Layer 2",
      answers:"Where things stand right now, where they're headed, and what runs on what rhythm.",
      livesIn:"A running log of what changed and why, a strategic-direction file, and a cadence table for every recurring routine.",
      mech:"State is re-read, not remembered, at the start of every session — so a week-old assumption never quietly overrides today's real position."
    },
    {
      name:"Knowledge", tag:"Layer 3",
      answers:"How this kind of work is supposed to be done properly, and where that knowledge came from.",
      livesIn:"Playbooks for repeatable work, verified reference material, and a separate pile of raw, unprocessed notes not yet promoted.",
      mech:"Knowledge is graded by confidence, not treated as uniformly true — a raw note and a verified method are never filed as the same kind of fact."
    },
    {
      name:"Skills", tag:"Layer 4",
      answers:"What procedure to follow for a given kind of task, instead of improvising it fresh each time.",
      livesIn:"A library of encoded processes, each one triggered by a matching phrase rather than reinvented in the moment.",
      mech:"A task is matched to its skill before work starts — the same job produces the same quality on the first attempt and the hundredth."
    },
    {
      name:"Entities", tag:"Layer 5",
      answers:"Who the work is actually for, and what's true about their situation specifically.",
      livesIn:"One self-contained folder per client, project, or prospect — its own backlog, its own working notes, its own data.",
      mech:"Nothing about one entity's data or context ever crosses into another's, by structure rather than by discipline."
    },
    {
      name:"Integrations", tag:"Layer 6",
      answers:"How it reaches the tools a business actually runs on, instead of living in an isolated chat window.",
      livesIn:"Connectors to analytics, advertising, the website, the inbox, the task list, the books, and the phone lines — built on an open standard.",
      mech:"Because the standard is open, no single vendor's shutdown or price hike strands the whole operation."
    },
    {
      name:"Ledger", tag:"Layer 7",
      answers:"What actually happened, when, and what was learned from it.",
      livesIn:"A dated entry for every session, a running decision journal, and domain-specific notebooks for what worked and what didn't.",
      mech:"This is the raw material the closing loop mines from — nothing gets better without this layer being honest first."
    }
  ];

  var steps = [
    {n:"01", name:"Boot", h:"Read identity and state first", p:"Before touching the actual request, it re-reads who it is, what's currently true, and what's already in flight. Nothing runs from a cold, contextless start."},
    {n:"02", name:"Route", h:"Match to an encoded procedure", p:"The request is matched against the skill library by trigger phrase. If a known-good process exists for this kind of task, that runs — improvisation is the fallback, not the default."},
    {n:"03", name:"Ground", h:"Pull live data, not memory", p:"Anything that can be checked against a live source is checked, rather than answered from what was true last time this came up. Stale confidence is treated as a real failure mode."},
    {n:"04", name:"Diagnose", h:"Conclusion first, then the case", p:"The hypothesis is stated in one sentence before the reasoning, with a confidence rating attached. Then the strongest argument against it gets written out, on purpose, before it's allowed to be final."},
    {n:"05", name:"Write", h:"Save it as a real file", p:"Output only counts once it exists as a dated, typed, status-tagged file at a determined location. Nothing important is left sitting only in a chat window."},
    {n:"06", name:"Record", h:"Log it with a date to check back", p:"A row goes into the ledger with a future date attached — a point where someone comes back and checks whether it actually worked, not just whether it was delivered."},
    {n:"07", name:"Close", h:"Note what was asked, delivered, and corrected", p:"The session ends with an honest account of the gap between what was requested and what actually happened, including anything that had to be fixed along the way."},
    {n:"08", name:"Learn", h:"Hand off to the closing loop", p:"That record becomes raw material for the next cycle — patterns get mined out of it on a fixed schedule, and the method that produced the mistake gets rewritten, not just the one output."}
  ];

  // ---- anatomy ----
  var bandList = document.getElementById('bandList');
  var detail = document.getElementById('anatomyDetail');
  bands.forEach(function(b, i){
    var li = document.createElement('li');
    var btn = document.createElement('button');
    btn.className = 'band-btn';
    btn.type = 'button';
    btn.setAttribute('role','tab');
    btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
    btn.id = 'band-tab-' + i;
    btn.innerHTML = '<span class="band-num">0' + (i+1) + '</span><span class="band-name">' + b.name + '</span>';
    btn.addEventListener('click', function(){ selectBand(i); });
    li.appendChild(btn);
    bandList.appendChild(li);
  });
  function selectBand(i){
    bands.forEach(function(b, j){
      document.getElementById('band-tab-' + j).setAttribute('aria-selected', j === i ? 'true' : 'false');
    });
    var b = bands[i];
    detail.innerHTML =
      '<p class="tag">' + b.tag + '</p>' +
      '<h3>' + b.name + '</h3>' +
      '<p class="answers">' + b.answers + '</p>' +
      '<p class="lives-in"><strong>Lives in</strong>' + b.livesIn + '</p>' +
      '<p class="mech">' + b.mech + '</p>';
  }
  selectBand(0);

  // ---- stepper ----
  var rail = document.getElementById('stepRail');
  var panel = document.getElementById('stepPanel');
  var prevBtn = document.getElementById('stepPrev');
  var nextBtn = document.getElementById('stepNext');
  var current = 0;

  steps.forEach(function(s, i){
    var tab = document.createElement('button');
    tab.className = 'step-tab';
    tab.type = 'button';
    tab.setAttribute('role','tab');
    tab.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
    tab.id = 'step-tab-' + i;
    tab.innerHTML = '<span class="n">' + s.n + '</span>' + s.name;
    tab.addEventListener('click', function(){ selectStep(i, true); });
    rail.appendChild(tab);
  });

  function selectStep(i, scrollRail){
    current = i;
    steps.forEach(function(s, j){
      document.getElementById('step-tab-' + j).setAttribute('aria-selected', j === i ? 'true' : 'false');
    });
    var s = steps[i];
    panel.innerHTML = '<h3>' + s.n + ' &middot; ' + s.h + '</h3><p>' + s.p + '</p>';
    prevBtn.disabled = i === 0;
    nextBtn.disabled = i === steps.length - 1;
    // Only nudge the rail's own horizontal scroll on user-triggered navigation.
    // scrollIntoView's block:'nearest' has no vertical scroll container to target
    // here (.step-rail only overflows horizontally), so on the initial render
    // (page load) the browser bubbles it up to the document and scrolls the
    // whole page down to this section — never call it on the default selection.
    if (scrollRail) {
      document.getElementById('step-tab-' + i).scrollIntoView({block:'nearest', inline:'center', behavior:'smooth'});
    }
  }
  prevBtn.addEventListener('click', function(){ if(current > 0) selectStep(current - 1, true); });
  nextBtn.addEventListener('click', function(){ if(current < steps.length - 1) selectStep(current + 1, true); });
  selectStep(0, false);
})();
</script>
</body>
</html>
