  <div class="article-body">
    {article.bodyHtml ? (
      <Fragment set:html={article.bodyHtml} />
    ) : (
      article.paragraphs?.map(p => <p>{p}</p>)
    )}
  </div>

  {!article.bodyHtml && (
    <>
      <div class="coming-soon">
        Full article coming soon. The diagnostic below gives you a personalised version of these insights specific to your practice — in 10 minutes.
      </div>

      <div class="cta-block">
        <h3>Find out where your practice is losing time — for free.</h3>
        <p>The AI Readiness Diagnostic benchmarks your practice across 4 systems. 20 statements. 10 minutes. You get a score, a tier, and a specific build order — what to fix first.</p>
        <a href="/score" class="btn-primary" style="display:inline-block;">Take the Free Diagnostic →</a>
      </div>
    </>
  )}

  <a href="/articles" class="back-link">← All articles</a>
</div>

</Base>
