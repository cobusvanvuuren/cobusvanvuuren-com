    <tr><td>Law firm</td><td>—</td><td>PaySpace, SimplePay</td><td>Fathom, Otter.ai</td><td>WhatsApp Business API</td></tr>
    <tr><td>Financial advisory</td><td>Xero, Sage</td><td>PaySpace, SimplePay</td><td>Fathom, Otter.ai</td><td>WhatsApp Business API</td></tr>
  </tbody>
</table>
