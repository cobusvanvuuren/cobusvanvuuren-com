---
// FireBackground.astro
// Hero background: a procedural WebGL flame (fractal Brownian motion + ridged noise
// for streak detail) with a fixed dark scrim so any content placed on top stays
// legible regardless of the flame's animated state. Original implementation of the
// standard, decades-old public FBM-fire shader technique (see "The Book of Shaders"
// ch.13) -- not derived from any paid product or third-party site's source.
// Pure vanilla WebGL, no framework dependency. Color ramp tuned to this site's own
// brand tokens (--color-crimson #C8282C, --color-copper #A67C52, --color-ivory
// #F5F0E8) rather than generic fire colours.
---

<div class="fire-bg-wrap">
  <canvas id="fire-canvas"></canvas>
  <div class="fire-scrim"></div>
</div>

<style>
  .fire-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  #fire-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .fire-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Radial coverage for the upper/mid content, plus an independent bottom-anchored
       layer for the lower content (proof strip) -- the shader is brightest near the
       base by construction, so the radial ellipse alone isn't reliably dark enough
       down there. Confirmed by testing against the real, taller hero (eyebrow through
       the 3-stat proof strip), not just a short mockup. */
    background:
      linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.4) 14%, rgba(0,0,0,0) 36%),
      radial-gradient(ellipse 68% 66% at 50% 46%, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.32) 55%, rgba(0,0,0,0.06) 85%, rgba(0,0,0,0) 100%);
  }
  /* Static fallback for prefers-reduced-motion or WebGL failure. */
  .fire-bg-wrap.fire-fallback {
    background: radial-gradient(ellipse 70% 90% at 50% 100%, #4a1013 0%, #1a0505 45%, #0B0A09 75%);
  }
</style>

<script>
  function initFire() {
    const canvas = document.getElementById('fire-canvas') as HTMLCanvasElement | null;
    const wrap = canvas?.closest('.fire-bg-wrap') as HTMLElement | null;
    if (!canvas || !wrap) return;

    // Render at half resolution and let the browser bilinear-upscale via CSS --
    // a soft, scrim-covered flame loses nothing visible and this alone cuts
    // fragment work 4x.
    const RES_SCALE = 0.5;

    const gl = canvas.getContext('webgl', {
      antialias: false,
      depth: false,
      stencil: false,
      alpha: false,
      powerPreference: 'low-power',
    });
    if (!gl) {
      wrap.classList.add('fire-fallback');
      canvas.style.display = 'none';
      return;
    }

    // Headless/software rasterizers (Lighthouse, GTmetrix, remote-desktop GPUs)
    // execute this shader on the CPU main thread -- genuinely too slow there.
    // Fall back to the static gradient rather than pretend it's fine.
    const dbgInfo = gl.getExtension('WEBGL_debug_renderer_info');
    if (dbgInfo) {
      const renderer = String(gl.getParameter(dbgInfo.UNMASKED_RENDERER_WEBGL) || '');
      if (/SwiftShader|llvmpipe|Software|Microsoft Basic Render/i.test(renderer)) {
        wrap.classList.add('fire-fallback');
        canvas.style.display = 'none';
        return;
      }
    }

    function resize() {
      const rect = wrap!.getBoundingClientRect();
      canvas!.width = Math.max(1, Math.floor(rect.width * RES_SCALE));
      canvas!.height = Math.max(1, Math.floor(rect.height * RES_SCALE));
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
    }
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 150);
    });

    const vertSrc = `
attribute vec2 aPos;
void main() {
  gl_Position = vec4(aPos, 0.0, 1.0);
}`;

    const fragSrc = `
precision highp float;
uniform vec2 uRes;
uniform float uTime;

vec2 hash2(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
  p3 += dot(p3, p3.yzx + 33.33);
  return -1.0 + 2.0 * fract((p3.xx + p3.yz) * p3.zy);
}

float valueNoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  float a = dot(hash2(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0));
  float b = dot(hash2(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));
  float c = dot(hash2(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));
  float d = dot(hash2(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p) {
  float sum = 0.0;
  float amp = 0.5;
  float freq = 1.0;
  for (int i = 0; i < 4; i++) {
    sum += amp * valueNoise(p * freq);
    freq *= 2.02;
    amp *= 0.5;
  }
  return sum;
}

float ridgedFbm(vec2 p) {
  float sum = 0.0;
  float amp = 0.5;
  float freq = 1.0;
  for (int i = 0; i < 3; i++) {
    float n = 1.0 - abs(valueNoise(p * freq));
    n = n * n;
    sum += amp * n;
    freq *= 2.05;
    amp *= 0.55;
  }
  return sum;
}

void main() {
  vec2 uv = gl_FragCoord.xy / uRes.xy;
  float aspect = uRes.x / uRes.y;
  vec2 p = uv * vec2(aspect, 1.0) * 3.0;

  float rise = uTime * 0.55;
  vec2 warpedP = p + vec2(fbm(p * 1.3 + rise * 0.15) * 0.6, 0.0);

  float base = fbm(warpedP - vec2(0.0, rise));
  float ridges = ridgedFbm(warpedP * 1.8 - vec2(0.0, rise * 1.3));

  float n = mix(base, ridges, 0.55);

  float taper = smoothstep(1.0, 0.15, uv.y);
  float centerFalloff = 1.0 - smoothstep(0.0, 0.9, abs(uv.x * aspect * 3.0 - aspect * 1.5));

  float intensity = clamp(n * 0.55 + 0.45, 0.0, 1.0);
  intensity *= taper;
  intensity *= mix(0.5, 1.0, centerFalloff);
  intensity = pow(intensity, 1.15);

  // Reuse the already-computed ridge value for streak detail instead of a
  // second ridgedFbm evaluation -- visually equivalent, one fewer noise pass.
  intensity -= (1.0 - ridges) * 0.22 * taper;
  intensity = clamp(intensity, 0.0, 1.0);

  // Brand-tuned ramp: near-black base -> crimson (#C8282C) -> copper (#A67C52) -> ivory (#F5F0E8) highlight
  vec3 c1 = vec3(0.03, 0.005, 0.005);
  vec3 c2 = vec3(0.35, 0.05, 0.06);
  vec3 c3 = vec3(0.784, 0.157, 0.173);
  vec3 c4 = vec3(0.65, 0.486, 0.322);
  vec3 c5 = vec3(0.961, 0.941, 0.910);

  vec3 col;
  if (intensity < 0.22) col = mix(c1, c2, intensity / 0.22);
  else if (intensity < 0.5) col = mix(c2, c3, (intensity - 0.22) / 0.28);
  else if (intensity < 0.8) col = mix(c3, c4, (intensity - 0.5) / 0.3);
  else col = mix(c4, c5, min((intensity - 0.8) / 0.2, 1.0));

  col *= smoothstep(1.0, 0.75, uv.y) * 0.85 + 0.15;

  gl_FragColor = vec4(col, 1.0);
}`;

    function compile(type: number, src: string) {
      const s = gl!.createShader(type)!;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) {
        console.error(gl!.getShaderInfoLog(s));
      }
      return s;
    }

    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vertSrc));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fragSrc));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uTime = gl.getUniformLocation(prog, 'uTime');

    resize();
    const startTime = performance.now();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // prefers-reduced-motion: paint one static frame and never touch
    // requestAnimationFrame at all.
    if (prefersReducedMotion) {
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, 0.0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      return;
    }

    let lastFrame = 0;
    const targetFPS = 30;
    const frameInterval = 1000 / targetFPS;
    let rafId: number | null = null;
    let inView = false;
    let pageVisible = !document.hidden;

    function draw(t: number) {
      rafId = requestAnimationFrame(draw);
      if (t - lastFrame < frameInterval) return;
      lastFrame = t;
      gl!.uniform2f(uRes, canvas!.width, canvas!.height);
      gl!.uniform1f(uTime, (t - startTime) / 1000);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }

    function startLoop() {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(draw);
    }
    function stop() {
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = null;
    }
    function syncRunning() {
      if (inView && pageVisible) startLoop();
      else stop();
    }

    // Only spend GPU/CPU while the hero is actually on screen.
    const io = new IntersectionObserver((entries) => {
      inView = entries.some((e) => e.isIntersecting);
      syncRunning();
    }, { threshold: 0 });
    io.observe(wrap);

    document.addEventListener('visibilitychange', () => {
      pageVisible = !document.hidden;
      syncRunning();
    });

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      stop();
      wrap!.classList.add('fire-fallback');
      canvas!.style.display = 'none';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFire);
  } else {
    initFire();
  }
</script>
